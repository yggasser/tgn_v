{  "version": 1,  "time_category": {    "regex": [      "^год\\s*:",      "^период\\s*:",      "^десятилетие\\s*:",      "строение\\s+\\d{4}",      "строение\\s+\\d{4}-х",      "строение\\s+\\d{2}-го\\s+века"    ]  },  "territories": {    "layers": [      {        "key": "districts",        "title": "Районы",        "category": "Районы",        "maxZoom": 14,        "fill": { "hueShift": 0, "sat": 55, "light": 82, "opacity": 0.34 },        "zIndex": 250,        "pane": "tDistrictsPane",        "labels": { "show": true, "center": "centroid", "class": "territory-label territory-label--district" }      },      {        "key": "micro",        "title": "Микрорайоны / кварталы / посёлки",        "category": "Микрорайоны",        "maxZoom": 15,        "fill": { "hueShift": 25, "sat": 50, "light": 85, "opacity": 0.26 },        "zIndex": 245,        "pane": "tMicroPane",        "labels": { "show": false, "center": "centroid", "class": "territory-label" }      },      {        "key": "prom",        "title": "Промзоны / крупные предприятия",        "category": "Промзоны",        "maxZoom": 15,        "fill": { "hueShift": 210, "sat": 45, "light": 84, "opacity": 0.22 },        "zIndex": 242,        "pane": "tPromPane",        "labels": { "show": false, "center": "centroid", "class": "territory-label" }      },      {        "key": "park",        "title": "Парки и скверы",        "category": "Парки и скверы",        "maxZoom": 15,        "fill": { "hueShift": 210, "sat": 45, "light": 84, "opacity": 0.22 },        "zIndex": 242,        "pane": "tPromPane",        "labels": { "show": true, "center": "centroid", "class": "territory-label" }      }    ]  },  "category_groups": [    { "name": "Территории", "order": 0, "match": { "exact": ["Районы","Микрорайоны","Промзоны","Парки и скверы","Кладбища"] } },    { "name": "Здания", "order": 1, "match": { "regex": ["дом","строение","здание","корпус","общежит"] } },    { "name": "Заведения", "order": 2, "match": { "regex": ["магазин","кафе","ресторан","школ","детсад","больниц","аптек"] } },    { "name": "Статус и охрана", "order": 3, "match": { "regex": ["памятник","культурного наследия","охраняем","истор"] } },    { "name": "Детали", "order": 4, "match": { "regex": ["ворота","парадн","цокол","окн","арка","фасад"] } },    { "name": "Прочее", "order": 9, "match": { "regex": [] } }  ],  "category_overrides": {    "не отображать название": { "hidden": true }  }}